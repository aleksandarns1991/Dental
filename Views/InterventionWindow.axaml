<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="Dental.Views.InterventionWindow"
        WindowStartupLocation="CenterScreen"
        CanResize="false"
        SizeToContent="WidthAndHeight"
        Title="Intervention"
        Icon="/Assets/Icons/intervention.ico">
  <Grid RowDefinitions="Auto,Auto,Auto,20,Auto" ColumnDefinitions="Auto,Auto" Margin="20">
      <TextBlock Text="Title:"/>
      <TextBox Name="textTitle" Grid.Column="1"/>

      <TextBlock Text="Price" Grid.Row="1"/>
      <TextBox Name="textPrice" Grid.Row="1" Grid.Column="1"/>

      <TextBlock Text="Description:" Grid.Row="2"/>
      <TextBox Name="textDescription" Grid.Row="2" Grid.Column="1"/>

      <Button Classes="save" Name="btnSave" Content="Save" Grid.Row="4" Grid.ColumnSpan="2"/>
  </Grid>
</Window>