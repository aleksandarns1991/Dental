<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Dental.Views.PatientListView">
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="20">
      <TextBlock Text="Search patient:"/>
      <TextBox Name="textSearch" Grid.Row="1"/>

      <TextBlock Text="Patients:" Grid.Row="2"/>
      <ListBox Name="listPatients" Grid.Row="3"/>

      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                  Orientation="Horizontal"
                  Grid.Row="4">
                  <Button Name="btnAdd" Content="Add"/>
                  <Button Name="btnEdit" Content="Edit"/>
                  <Button Name="btnDelete" Content="Delete"/>
      </StackPanel>
  </Grid>
</UserControl>
